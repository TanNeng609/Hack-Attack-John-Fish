// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored -- never commit real WiFi/Firebase credentials.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Firebase project config (from john-fish Firebase project settings).
// DATABASE_URL: open Firebase Console > Build > Realtime Database and copy the
// exact URL shown at the top of the data viewer.
#define DATABASE_URL    "https://john-fish-default-rtdb.firebaseio.com"

// Firebase Console > Project Settings > Service Accounts > Database Secrets
// (legacy secret, simplest auth path for a prototype/hackathon build).
#define DATABASE_SECRET "your-database-secret"

#endif
